<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>One Page — Distrito Itaqui</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#101820;
    --ink-soft:#1c2733;
    --ivory:#F7F4EC;
    --paper:#FCFAF5;
    --sage:#6E7F5C;
    --sage-deep:#4B5A3D;
    --sage-pale:#E4E9DA;
    --brass:#B08D4F;
    --brass-pale:#EFE3C8;
    --line:#DAD4C4;
    --text-muted:#6B675C;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:#EDE9DF;
    font-family:'Inter',sans-serif;
    color:var(--ink);
    display:flex;
    justify-content:center;
    padding:40px 20px;
  }
  .sheet{
    width:1200px;
    max-width:100%;
    background:var(--paper);
    box-shadow:0 30px 60px -20px rgba(16,24,32,0.35);
    overflow:hidden;
  }
  /* Header */
  .header{
    background:var(--ink);
    color:var(--ivory);
    padding:44px 56px 36px;
    position:relative;
    border-bottom:2px solid var(--brass);
  }
  .eyebrow{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    letter-spacing:.22em;
    text-transform:uppercase;
    color:var(--brass);
    margin:0 0 10px;
  }
  .title{
    font-family:'Fraunces',serif;
    font-weight:500;
    font-size:44px;
    letter-spacing:.01em;
    margin:0 0 26px;
  }
  .meta{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:40px;
  }
  .meta-left p{
    margin:0 0 6px;
    font-size:14px;
    line-height:1.7;
    color:#D9D5C8;
  }
  .meta-left p span{color:var(--ivory);font-weight:500;}
  .status-box{
    display:flex;
    gap:36px;
    border-left:1px solid rgba(247,244,236,0.25);
    padding-left:36px;
  }
  .status-item{text-align:center;}
  .status-label{
    font-family:'IBM Plex Mono',monospace;
    font-size:10px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:#B7B2A2;
    margin-bottom:10px;
  }
  .dot{
    width:14px;height:14px;border-radius:50%;
    background:var(--sage);
    margin:0 auto 8px;
    box-shadow:0 0 0 4px rgba(110,127,92,0.18);
  }
  .status-word{
    font-size:12px;
    color:var(--ivory);
    font-weight:500;
  }

  /* Body grid */
  .body{
    display:grid;
    grid-template-columns:1.02fr 1px 0.98fr;
    gap:48px;
    padding:44px 56px 0;
  }
  .divider{background:var(--line);}

  .section-label{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--sage-deep);
    margin:0 0 4px;
  }
  .section-title{
    font-family:'Fraunces',serif;
    font-size:24px;
    font-weight:500;
    margin:0 0 22px;
    color:var(--ink);
  }

  /* Kanban */
  .kanban{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
    margin-bottom:28px;
  }
  .kcard{
    background:var(--ivory);
    border:1px solid var(--line);
    border-top:3px solid var(--sage);
    padding:20px 14px;
    text-align:center;
  }
  .kcard.doing{border-top-color:var(--brass);}
  .kcard.validation{border-top-color:var(--ink-soft);}
  .knum{
    font-family:'Fraunces',serif;
    font-size:34px;
    font-weight:500;
    line-height:1;
    margin-bottom:8px;
  }
  .klabel{
    font-family:'IBM Plex Mono',monospace;
    font-size:10px;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--text-muted);
  }

  .issue{
    padding:16px 0;
    border-bottom:1px solid var(--line);
  }
  .issue:last-child{border-bottom:none;}
  .issue-title{
    font-size:14px;
    font-weight:600;
    margin:0 0 6px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .issue-title::before{
    content:"";
    width:6px;height:6px;
    background:var(--sage);
    border-radius:50%;
    flex-shrink:0;
  }
  .issue p{
    margin:0 0 6px;
    font-size:13.5px;
    line-height:1.65;
    color:var(--text-muted);
  }
  .issue p:last-child{margin-bottom:0;}
  .tag{
    display:inline-block;
    font-family:'IBM Plex Mono',monospace;
    font-size:10.5px;
    letter-spacing:.04em;
    padding:2px 8px;
    background:var(--sage-pale);
    color:var(--sage-deep);
    border-radius:2px;
    margin-right:6px;
  }
  .tag.done{background:var(--brass-pale);color:#7A5F2C;}

  .callout{
    margin-top:24px;
    background:var(--ink);
    color:var(--ivory);
    padding:18px 22px;
    font-size:13.5px;
    line-height:1.6;
    position:relative;
    border-left:3px solid var(--brass);
  }
  .callout b{color:var(--brass-pale);}

  /* Right column: strategy + timeline */
  .right-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    margin-bottom:4px;
  }
  .strategy-btn{
    font-family:'IBM Plex Mono',monospace;
    font-size:10.5px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--ink);
    background:transparent;
    border:1px solid var(--ink);
    padding:9px 16px;
    white-space:nowrap;
  }

  .timeline{
    position:relative;
    margin-top:10px;
    padding-left:46px;
  }
  .timeline::before{
    content:"";
    position:absolute;
    left:15px;
    top:6px;
    bottom:6px;
    width:1px;
    background:var(--line);
  }
  .tstep{
    position:relative;
    padding-bottom:30px;
  }
  .tstep:last-child{padding-bottom:0;}
  .tdot{
    position:absolute;
    left:-46px;
    top:2px;
    width:30px;height:30px;
    border-radius:50%;
    background:var(--paper);
    border:1.5px solid var(--line);
    display:flex;align-items:center;justify-content:center;
  }
  .tdot.done{
    border-color:var(--sage);
    background:var(--sage-pale);
  }
  .tdot span{
    width:8px;height:8px;border-radius:50%;
    background:var(--line);
  }
  .tdot.done span{background:var(--sage-deep);}
  .tname{
    font-size:14.5px;
    font-weight:600;
    margin:0 0 3px;
  }
  .tdate{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px;
    color:var(--text-muted);
  }
  .tnote{
    margin-top:10px;
    background:var(--ivory);
    border:1px solid var(--line);
    padding:12px 14px;
    font-size:12.5px;
    line-height:1.6;
    color:var(--ink-soft);
  }
  .tnote b{color:var(--sage-deep);}

  .approval{
    margin:32px 0 0;
    border:1px solid var(--line);
    border-top:3px solid var(--brass);
    background:var(--ivory);
    padding:20px 24px;
  }
  .approval-label{
    font-family:'IBM Plex Mono',monospace;
    font-size:10px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--brass);
    margin:0 0 8px;
  }
  .approval p{margin:0 0 6px;font-size:14px;line-height:1.6;}
  .approval p:last-child{margin-bottom:0;color:var(--text-muted);font-size:13px;}

  .footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:36px 56px 40px;
    margin-top:36px;
    border-top:1px solid var(--line);
  }
  .brand{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:22px;
    letter-spacing:-0.01em;
    color:var(--ink);
  }
  .footer-note{
    font-family:'IBM Plex Mono',monospace;
    font-size:10.5px;
    letter-spacing:.1em;
    text-transform:uppercase;
    color:var(--text-muted);
  }
</style>
</head>
<body>
<div class="sheet">

  <div class="header">
    <p class="eyebrow">Relatório de acompanhamento · Ciclo 06 – 17/07/2026</p>
    <h1 class="title">One page</h1>
    <div class="meta">
      <div class="meta-left">
        <p>Cliente — <span>Distrito Itaqui</span></p>
        <p>Projeto — <span>Manutenção site &amp; Top Voice</span></p>
        <p>Ciclo de entregas — <span>06 a 17 de julho de 2026</span></p>
      </div>
      <div class="status-box">
        <div class="status-item">
          <div class="status-label">Overall</div>
          <div class="dot"></div>
          <div class="status-word">Healthy</div>
        </div>
        <div class="status-item">
          <div class="status-label">Squad ATI</div>
          <div class="dot"></div>
          <div class="status-word">Healthy</div>
        </div>
      </div>
    </div>
  </div>

  <div class="body">
    <div class="col-left">
      <p class="section-label">Squad manutenção site</p>
      <h2 class="section-title">Status macro — ClickUp</h2>

      <div class="kanban">
        <div class="kcard">
          <div class="knum">7</div>
          <div class="klabel">To do</div>
        </div>
        <div class="kcard doing">
          <div class="knum">2</div>
          <div class="klabel">Doing</div>
        </div>
        <div class="kcard validation">
          <div class="knum">2</div>
          <div class="klabel">Validation</div>
        </div>
      </div>

      <div class="issue">
        <p class="issue-title">Erro 404 em páginas legadas</p>
        <p>Páginas legadas geraram inconsistência de navegação. O primeiro bloco de correções já está em teste.</p>
        <p><span class="tag">Em estimativa</span> Imagens com erro 404 seguem o mesmo diagnóstico no site atual. Ação preventiva: plugin de monitoramento contínuo para mitigar novas ocorrências.</p>
      </div>

      <div class="issue">
        <p class="issue-title">Slug antigo exibido (Old Trashed)</p>
        <p><span class="tag done">Concluído</span> Mapeamento finalizado; correção aplicada ajustando o comportamento das páginas órfãs identificadas.</p>
      </div>

      <div class="callout">
        Itens aprovados até <b>10/07</b> entram em produção somente na segunda-feira, <b>13/07</b>.
      </div>
    </div>

    <div class="divider"></div>

    <div class="col-right">
      <div class="right-top">
        <div>
          <p class="section-label">Squad ATI</p>
          <h2 class="section-title" style="margin-bottom:26px;">Linha do tempo</h2>
        </div>
        <button class="strategy-btn">Estratégia</button>
      </div>

      <div class="timeline">
        <div class="tstep">
          <div class="tdot done"><span></span></div>
          <p class="tname">Discovery &amp; planning</p>
          <p class="tdate">15/07/2026</p>
        </div>
        <div class="tstep">
          <div class="tdot done"><span></span></div>
          <p class="tname">Design</p>
          <p class="tdate">08/07/2026</p>
          <div class="tnote"><b>Backoffice</b> — gerenciamento de perguntas. Usuário CIO responde às perguntas.</div>
        </div>
        <div class="tstep">
          <div class="tdot done"><span></span></div>
          <p class="tname">Planning / desenvolvimento</p>
          <p class="tdate">13 a 31/07</p>
        </div>
        <div class="tstep">
          <div class="tdot"><span></span></div>
          <p class="tname">Teste</p>
          <p class="tdate">27 a 31/07</p>
        </div>
        <div class="tstep">
          <div class="tdot"><span></span></div>
          <p class="tname">Homologação</p>
          <p class="tdate">03 a 06/08</p>
        </div>
        <div class="tstep">
          <div class="tdot"><span></span></div>
          <p class="tname">Deploy</p>
          <p class="tdate">10/08/2026</p>
        </div>
      </div>

      <div class="approval">
        <p class="approval-label">Aprovação do cliente</p>
        <p>Design e plano de trabalho</p>
        <p>Agenda marcada para 13/07/2026.</p>
      </div>
    </div>
  </div>

  <div class="footer">
    <div class="brand">buildbox</div>
    <div class="footer-note">Confidencial · Distrito Itaqui × Buildbox</div>
  </div>

</div>
</body>
</html>
